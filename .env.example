NODE_ENV=development
PORT=5000
MONGO_URI=your_mongodb_connection_string/teamorbit-dev
JWT_ACCESS_SECRET=replace_this_with_a_secure_random_string_for_access_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_this_with_a_secure_random_string_for_refresh_token
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

SUPER_ADMIN_EMAIL=superadmin@teamorbit.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123!
SUPER_ADMIN_NAME=Super Admin

CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
